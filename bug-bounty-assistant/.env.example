# .env – Local configuration for the authorized assessment toolkit.
# Copy this file to .env and fill in your values.
# DO NOT commit .env to source control.

# Path to the allowlist file (one approved domain/URL per line).
ALLOWLIST_PATH=data/allowlist.txt

# SQLite database for storing scans and findings.
DB_PATH=data/findings.db

# Directory where Markdown reports are saved.
REPORTS_DIR=data/reports

# HTTP request timeout in seconds.
REQUEST_TIMEOUT=10

# User-Agent string sent with reconnaissance requests.
USER_AGENT=AuthorizedLabScanner/1.0 (local assessment only)
